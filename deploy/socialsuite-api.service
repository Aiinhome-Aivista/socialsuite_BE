# /etc/systemd/system/socialsuite-api.service
[Unit]
Description=Social Suite FastAPI
After=network.target mysql.service

[Service]
User=www-data
WorkingDirectory=/var/www/social-suite/backend
Environment="PATH=/var/www/social-suite/backend/.venv/bin"
ExecStart=/var/www/social-suite/backend/.venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    -w 4 -b 127.0.0.1:8000 \
    --timeout 120
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
